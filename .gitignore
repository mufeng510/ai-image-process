# FFmpeg binaries are fetched locally (~80MB), never committed.
# Version lock lives in Tools/ffmpeg/SOURCE.txt (tracked).
Tools/ffmpeg/ffmpeg.exe
Tools/ffmpeg/ffprobe.exe
Tools/ffmpeg/ffmpeg
Tools/ffmpeg/ffprobe
# Native (unix) ExifTool is fetched by scripts/fetch_exiftool.sh, never
# committed. The Windows distribution (exiftool.exe + exiftool_files/) IS
# tracked, so Windows builds need no fetch step.
Tools/exiftool/exiftool
Tools/exiftool/exiftool.pl
Tools/exiftool/lib/
Tools/exiftool/SOURCE-UNIX.txt
# The whole tree is fetched by scripts/fetch_perl.sh, SOURCE.txt included.
# Ignoring per-subdir left a gap that swallowed a stray copy of the tree.
Tools/perl/
